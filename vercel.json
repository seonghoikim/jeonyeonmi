{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jeonyeonmi.vercel.app" }],
      "destination": "https://jeonyeonmi.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/(.*)", "destination": "/en/index.html" },
    { "source": "/works/(.*)", "destination": "/index.html" }
  ]
}
